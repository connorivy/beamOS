{
  "name": "@beamos/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:db": "sh -c 'set -e; docker compose -f ../../../docker-compose.yml up -d --wait db; trap \"docker compose -f ../../../docker-compose.yml down\" EXIT INT TERM; DB_URI=${DB_URI:-postgresql://beamos:beamos@${DB_HOST:-127.0.0.1}:${DB_PORT:-5432}/beamos} PORT=${PORT:-3001} bun run dev'",
    "dev:test": "PORT=3001 bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test": "bun run test:unit && bun run test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@beamos/contracts": "workspace:*",
    "@elysiajs/openapi": "^1.4.14",
    "drizzle-orm": "^1.0.0-beta.9-e89174b",
    "elysia": "^1.4.25",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1",
    "@beamos/openapi-client": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.28.0",
    "drizzle-kit": "^1.0.0-beta.9-e89174b",
    "testcontainers": "^10.28.0"
  }
}
